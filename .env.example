# Mailbox the worker watches, and sends from.
EMAIL_USER=arxiv2kindle@outlook.com
EMAIL_PASSWORD=your-password
EMAIL_IMAP_HOST=outlook.office365.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp-mail.outlook.com
EMAIL_SMTP_PORT=587

# Where converted papers are delivered. EMAIL_USER must be on your Amazon
# "Approved Personal Document E-mail List" or Amazon will drop the message.
KINDLE_EMAIL=your-name@kindle.com

# Only these senders are acted on; anything else is left unread. Comma separated.
ALLOWED_SENDERS=your-personal@email.com

# How often to check the inbox, in milliseconds.
POLL_INTERVAL_MS=30000

# Unused by this version, which renders from arXiv's HTML rather than driving a
# headless browser. Kept so an .env from arxiv2kindle works as-is.
CHROME_PATH=/usr/bin/google-chrome

# --- Optional, all with working defaults ------------------------------------
# MATH_FORMAT=svg          # svg | inline-svg | png  (inline-svg for dark mode)
# MAX_ATTACHMENT_MB=25     # refuse to mail anything larger
# MAILBOX=INBOX            # IMAP folder to watch
# OUTPUT_DIR=/out          # inside the container
# CACHE_DIR=/cache
# DRY_RUN=false            # convert and reply, but never actually send mail
# TZ=UTC                   # log timestamps
